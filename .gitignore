# Environment / secrets
.env
.env.*
*.env
.gemini/
GoogleAIStudio/

# Database files (contain real user data)
*.db
*.sqlite
*.sqlite3
/db/

# macOS
.DS_Store

# VSCode
/.vscode/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node
node_modules/

# Claude Code
.claude/

# Misc
backend/tests/sample/
last_commit_hash.txt
.flake8

# Ignore user-specific SQL session/query files
sql/*.sql

# Local data files (personal brokerage CSVs — never commit)
data/

# Personal session notes and ticker allowlist — real holdings, never commit
/context.md
/config/tickers.yml

# One-time migration scripts (depend on local data/ files).
# Uses scripts/* rather than scripts/ so the exceptions below can re-include
# individual files — git can't un-ignore a file whose parent directory is excluded.
scripts/*
# Backup tooling is infrastructure, not a one-off migration.
!scripts/backup_db.sh
!scripts/com.wealthcompass.backup.plist
